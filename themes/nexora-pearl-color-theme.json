    "editorHoverWidget.background": "#FFFFFF",
    "editorHoverWidget.border": "#D5DDE9",
    "editorCodeLens.foreground": "#718096",
    "editorLink.activeForeground": "#087F8C",
    "editorInlayHint.foreground": "#718096",
    "editorInlayHint.background": "#E7ECF4",
    "editorStickyScroll.background": "#FFFFFF",
    "editorStickyScrollHover.background": "#E7ECF4",
    "editorGroupHeader.tabsBackground": "#EDF1F7",
    "editorGroupHeader.tabsBorder": "#D5DDE9",
    "tab.activeBackground": "#F5F7FB",
